# Copy to .env.production on the server and fill in real values.
INFISICAL_CLIENT_ID=your_client_id_here
INFISICAL_CLIENT_SECRET=your_client_secret_here
INFISICAL_PROJECT_ID=your_project_id_here
USE_INFISICAL=true

# Which Infisical environment (slug) to load secrets FROM
INFISICAL_ENVIRONMENT=staging

# How the app BEHAVES (safety checks, docs, SSL)
ENVIRONMENT=staging

GRAFANA_PASSWORD=your_grafana_password_here
SENTRY_TRACES_SAMPLE_RATE=0.1
TRUSTED_PROXY_IPS=127.0.0.1,172.30.0.1