# .env.production.example
# Copy to .env.production on your Contabo VPS and fill in real values.
# NEVER commit .env.production to git — it is already in .gitignore.
#
# On Contabo VPS:
#   cp .env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Enables Infisical secrets loading at startup
USE_INFISICAL=true

# Infisical universal auth credentials
# Get from app.infisical.com → your project → Access → Machine Identities
INFISICAL_CLIENT_ID=your_client_id_here
INFISICAL_CLIENT_SECRET=your_client_secret_here
INFISICAL_PROJECT_ID=your_project_id_here

# Environment name — tells Infisical which environment to load secrets from
ENVIRONMENT=production

# ─── OPTIONAL OVERRIDES ───────────────────────────────────────────────────────
# Only set if you need to override what Infisical provides

# Trusted proxy IPs for Nginx → FastAPI X-Forwarded-For header
TRUSTED_PROXY_IPS=127.0.0.1,172.17.0.1