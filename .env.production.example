# Copy to .env.production on the server and fill in real values:
#   cp .env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production

# Infisical machine identity credentials
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_PROJECT_ID=your-project-id
USE_INFISICAL=true

# Which Infisical environment (slug) to load secrets FROM
INFISICAL_ENVIRONMENT=prod

# How the app BEHAVES (safety checks, docs, SSL). Must match the Infisical value.
ENVIRONMENT=production

TRUSTED_PROXY_IPS=127.0.0.1,172.17.0.1
GRAFANA_PASSWORD=your_grafana_password_here
SENTRY_TRACES_SAMPLE_RATE=0.1