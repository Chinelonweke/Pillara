# ─── PILLARA ENVIRONMENT VARIABLES ───────────────────────────────────────────
# Copy this file to .env and fill in real values for local development.
# Production secrets are managed via Infisical (INFISICAL_ENVIRONMENT=production).
# NEVER commit .env to git.

# ─── INFISICAL (secrets management) ──────────────────────────────────────────
USE_INFISICAL=true
INFISICAL_PROJECT_ID=your_project_id_here
INFISICAL_ENVIRONMENT=dev
INFISICAL_CLIENT_ID=your_client_id_here
INFISICAL_CLIENT_SECRET=your_client_secret_here
INFISICAL_SITE_URL=https://app.infisical.com

# ─── APP ──────────────────────────────────────────────────────────────────────
APP_NAME=Pillara
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ─── DATABASE (NeonDB) ────────────────────────────────────────────────────────
# Dev branch URL from neon.tech → your project → Branches → dev → Connect
# Remove ?sslmode=require&channel_binding=require from the end
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-dev.neon.tech/neondb

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Local Docker Redis (development)
# Production: redis://redis:6379 (Docker container name)
REDIS_URL=redis://localhost:6380

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters

# ─── LLM PROVIDERS ────────────────────────────────────────────────────────────
# Groq (primary) — console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Cerebras (fallback 1) — cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here

# OpenRouter (fallback 2) — openrouter.ai → Keys
# Requires $1 minimum balance to use free models
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Together AI (fallback 3) — api.together.xyz
TOGETHER_API_KEY=your_together_key_here

# HuggingFace (fallback 4) — huggingface.co → Settings → Access Tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here

# ─── VECTOR DATABASE (ChromaDB) ───────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=drug_knowledge

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_your_resend_key_here
FROM_EMAIL=noreply@pillara.site
ALERT_EMAIL=your_alert_email@example.com
ALERT_FROM_EMAIL=alerts@pillara.site

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production: https://pillara.site
FRONTEND_URL=http://localhost:3000

# ─── MONITORING ───────────────────────────────────────────────────────────────
# Sentry — sentry.io → your project → Settings → Client Keys
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# PostHog — app.posthog.com → your project → Settings → Project API Key
POSTHOG_API_KEY=phc_your_posthog_key_here

# ─── GRAFANA ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRAFANA_PASSWORD=your_grafana_password_here

# ─── FDA API (optional) ───────────────────────────────────────────────────────
FDA_API_KEY=your_fda_api_key_here

# ─── PUSH NOTIFICATIONS (optional — post-launch) ──────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:noreply@pillara.site

# ─── SMS (optional — post-launch) ─────────────────────────────────────────────
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173